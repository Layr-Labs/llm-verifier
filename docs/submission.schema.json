{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inert submission manifest v1",
  "description": "Structural reference; executable validator checks source snapshots, restricted input dialect and budgets.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8000
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "input_schema": {
            "type": "object",
            "description": "Restricted bounded input dialect in configuration.md. All references and unrecognized keywords forbidden by executable validator."
          },
          "initial_inputs": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "id",
          "source",
          "purpose",
          "input_schema",
          "initial_inputs"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 16,
      "description": "One canonical typed input per registered ID; all declared checks execute initially within shared budgets.",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "inputs": {
            "type": "object",
            "description": "Registry input schema and canonical 16 KiB cap validated locally."
          }
        },
        "required": [
          "check",
          "inputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "title",
    "claims",
    "experiments"
  ],
  "additionalProperties": false
}
