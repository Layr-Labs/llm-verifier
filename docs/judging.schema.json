{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected judge selection v1",
  "description": "All paths are relative to the challenge root. Nested file pointers are prohibited by the loader.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
        }
      },
      "required": [
        "path"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^(builtin|local):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "catalogs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
          }
        },
        "add_members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "persona": {
                "type": "string",
                "pattern": "^(builtin|local):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "stage": {
                "const": "review"
              },
              "provider": {
                "$ref": "#/$defs/judgeProvider"
              }
            },
            "required": [
              "id",
              "persona",
              "stage"
            ]
          }
        },
        "overrides": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "persona": {
                "type": "string",
                "pattern": "^(builtin|local):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "provider": {
                "$ref": "#/$defs/judgeProvider"
              }
            },
            "required": []
          }
        },
        "max_regions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Decomposed protocol only; maximum number of source regions (default 8)."
        }
      },
      "required": [
        "profile"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "enum": [
            "single-v1",
            "review-defense-adjudication-v1",
            "decomposed-review-v1"
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/judgeMember"
          }
        },
        "catalogs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
          }
        },
        "max_regions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "description": "Decomposed protocol only; maximum number of source regions (default 8)."
        }
      },
      "required": [
        "protocol",
        "members"
      ]
    }
  ],
  "$defs": {
    "judgeProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "not": {
            "pattern": "^(?:[Aa][Uu][Tt][Oo]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt])$"
          }
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768,
          "default": 8192
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200,
          "default": 60
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 262144
        },
        "response_format": {
          "enum": [
            "json_schema",
            "json_object"
          ],
          "default": "json_schema"
        },
        "background": {
          "type": "boolean",
          "description": "Opt in to bounded Responses background polling with store=false."
        }
      },
      "required": []
    },
    "judgeMember": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "persona": {
          "type": "string",
          "pattern": "^(builtin|local):[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "stage": {
          "enum": [
            "review",
            "defense",
            "adjudication",
            "planning",
            "region"
          ]
        },
        "provider": {
          "$ref": "#/$defs/judgeProvider"
        }
      },
      "required": [
        "id",
        "persona",
        "stage"
      ]
    }
  }
}
