{
  "schemaVersion": 2,
  "name": "shared-verifier-computation",
  "tracks": [
    {
      "name": "main",
      "description": "Offline plumbing example; organizer must configure model and publish pinned workflow before import.",
      "category": "math",
      "mode": "pareto",
      "promotionMode": "manual",
      "direction": "+",
      "objectives": [
        {
          "name": "checked_n",
          "direction": "+"
        }
      ],
      "paretoPolicies": {
        "scoring": {
          "version": "finite-prefix-v1"
        },
        "validity": {
          "version": "scoped-claims-v1"
        }
      },
      "editablePaths": [
        "submission"
      ],
      "setupCommand": [
        "llm-verifier",
        "intake",
        "--root",
        ".",
        "--out",
        ".yukon/work/intake.json"
      ],
      "benchmarkCommand": [
        "llm-verifier",
        "finalize",
        "--intake",
        ".yukon/work/intake.json",
        "--initial",
        ".yukon/work/initial.json",
        "--initial-review",
        ".yukon/work/review.json",
        "--score",
        ".yukon/score.json",
        "--dossier",
        ".yukon/dossier.json",
        "--followup",
        ".yukon/work/followup.json",
        "--final-review",
        ".yukon/work/final-review.json"
      ],
      "scorePath": ".yukon/score.json",
      "maxSubmissionBytes": 262144,
      "runner": {
        "provider": "github-actions",
        "workflow": "benchmark.yml",
        "scoreArtifactName": "benchmark-score",
        "maxConcurrentWorkflows": 2
      }
    }
  ]
}
