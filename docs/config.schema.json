{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protected LLM verifier config v1",
  "description": "Structural reference; llm_verifier.config additionally enforces policy matching, uniqueness and cross-field constraints.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "rules_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
    },
    "review_standard": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "objectives": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "direction": {
            "enum": [
              "+",
              "-"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "semantics": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "score_source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim"
                ],
                "properties": {
                  "claim": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 31
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "check",
                  "field"
                ],
                "properties": {
                  "check": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "score_minimum": {
            "$ref": "#/$defs/scoreBound",
            "description": "Inclusive exact lower bound for a score_source objective; reduced finite rational. Enforced independently of model acceptance."
          },
          "score_maximum": {
            "$ref": "#/$defs/scoreBound",
            "description": "Inclusive exact upper bound for a score_source objective; reduced finite rational. Enforced independently of model acceptance."
          }
        },
        "required": [
          "name",
          "direction",
          "unit",
          "semantics"
        ],
        "additionalProperties": false
      }
    },
    "allow_unscored": {
      "type": "boolean"
    },
    "policies": {
      "type": "object",
      "properties": {
        "scoring": {},
        "validity": {}
      },
      "required": [
        "scoring",
        "validity"
      ],
      "additionalProperties": false
    },
    "supported_policies": {
      "type": "object",
      "properties": {
        "scoring": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "selector": {},
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "selector",
              "instructions"
            ],
            "additionalProperties": false
          }
        },
        "validity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "selector": {},
              "instructions": {
                "type": "string",
                "minLength": 1,
                "maxLength": 16000
              }
            },
            "required": [
              "selector",
              "instructions"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scoring",
        "validity"
      ],
      "additionalProperties": false
    },
    "provider": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$",
          "not": {
            "pattern": "^(?:[Aa][Uu][Tt][Oo]|[Dd][Ee][Ff][Aa][Uu][Ll][Tt])$"
          }
        },
        "reasoning_effort": {
          "type": "string",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "max_completion_tokens": {
          "type": "integer",
          "minimum": 128,
          "maximum": 32768,
          "default": 8192
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200,
          "default": 60
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 2
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1048576,
          "default": 262144
        },
        "response_format": {
          "enum": [
            "json_schema",
            "json_object"
          ],
          "default": "json_schema"
        },
        "background": {
          "type": "boolean",
          "description": "Opt in to bounded Responses background polling with store=false."
        }
      },
      "required": [
        "model"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^(docker\\.io/library/)?python:[A-Za-z0-9._-]+@sha256:[a-f0-9]{64}$"
        },
        "platform": {
          "const": "linux/amd64"
        }
      },
      "required": [
        "image",
        "platform"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_files": {
          "type": "integer",
          "default": 32,
          "minimum": 1,
          "maximum": 128
        },
        "max_file_bytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 1,
          "maximum": 262144
        },
        "max_submission_bytes": {
          "type": "integer",
          "default": 262144,
          "minimum": 1,
          "maximum": 1048576
        },
        "max_initial_runs": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 12
        },
        "max_followups": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "maximum": 8
        },
        "run_seconds": {
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 120
        },
        "initial_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 600
        },
        "followup_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 600
        },
        "total_seconds": {
          "type": "integer",
          "default": 60,
          "minimum": 1,
          "maximum": 600
        },
        "stdout_bytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 64,
          "maximum": 262144
        },
        "stderr_bytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 64,
          "maximum": 262144
        },
        "total_output_bytes": {
          "type": "integer",
          "default": 393216,
          "minimum": 128,
          "maximum": 4194304
        },
        "memory_mb": {
          "type": "integer",
          "default": 256,
          "minimum": 64,
          "maximum": 1024
        },
        "cpus": {
          "type": "integer",
          "default": 1,
          "minimum": 1,
          "maximum": 4
        },
        "pids": {
          "type": "integer",
          "default": 32,
          "minimum": 8,
          "maximum": 128
        },
        "tmpfs_mb": {
          "type": "integer",
          "default": 16,
          "minimum": 1,
          "maximum": 64
        },
        "max_prompt_bytes": {
          "type": "integer",
          "default": 2097152,
          "minimum": 1024,
          "maximum": 8388608
        },
        "total_review_seconds": {
          "type": "integer",
          "default": 180,
          "minimum": 1,
          "maximum": 2400
        },
        "total_provider_requests": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "maximum": 6
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "checkers": {
      "type": "array",
      "maxItems": 16,
      "description": "Protected registry; unique IDs, aggregate source budgets and required boolean passed are enforced by the executable validator. See checkers.md.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
            }
          },
          "input_schema": {
            "type": "object",
            "description": "Bounded closed object in the executable restricted JSON Schema dialect; 16 KiB limit."
          },
          "output_schema": {
            "type": "object",
            "description": "Same bounded closed object dialect; required checkers must require a boolean passed property."
          },
          "required_for_score": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "description",
          "source",
          "files",
          "input_schema",
          "output_schema",
          "required_for_score"
        ],
        "additionalProperties": false
      }
    },
    "evidence_policy": {
      "enum": [
        "atomic-claims-v1",
        "exploratory-v1"
      ],
      "description": "Normalized policy provenance; must match explicit acceptance_policy (atomic-claims-v1 by default). External-evidence requirements apply to both policies."
    },
    "manifest_preprocessor": {
      "type": "string",
      "enum": [
        "curvesmash-v1"
      ],
      "description": "Optional protected manifest adapter. Omission preserves strict input requirements. Original files and exact transformation audit are retained; see preprocessing.md."
    },
    "acceptance_policy": {
      "enum": [
        "atomic-claims-v1",
        "exploratory-v1"
      ],
      "default": "atomic-claims-v1"
    },
    "rules_files": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
      },
      "description": "Additional protected rule files included verbatim in reviewer context."
    },
    "submission_selector": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
        }
      },
      "required": [
        "path",
        "directory"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "id",
    "rules_path",
    "review_standard",
    "objectives",
    "allow_unscored",
    "policies",
    "supported_policies",
    "provider"
  ],
  "additionalProperties": false,
  "$defs": {
    "scoreBound": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$",
          "maxLength": 256
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 256
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    }
  }
}
