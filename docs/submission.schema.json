{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inert submission manifest v1",
  "description": "Structural reference; executable validator checks source snapshots, restricted input dialect and budgets.",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "evidence"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "score": {
                "oneOf": [
                  {
                    "const": "positive_infinity"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "properties": {
                      "numerator": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^(0|-?[1-9][0-9]*)$"
                      },
                      "denominator": {
                        "type": "string",
                        "maxLength": 256,
                        "pattern": "^[1-9][0-9]*$"
                      }
                    }
                  }
                ]
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "structured": {
                "type": "object",
                "minProperties": 1,
                "description": "Exact inert JSON assertions reviewed as part of this original claim. Requires protected structured_claims: atomic-v1. At most 16 KiB canonical JSON; domain interpretation belongs to protected rules. Does not supply a numeric score."
              }
            },
            "anyOf": [
              {
                "required": [
                  "score"
                ]
              },
              {
                "required": [
                  "structured"
                ]
              }
            ]
          }
        ]
      }
    },
    "experiments": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Safe relative POSIX path, no traversal, symlinks, .git, controls or special files; additional runtime checks."
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "input_schema": {
            "type": "object",
            "description": "Restricted bounded input dialect in configuration.md. All references and unrecognized keywords forbidden by executable validator."
          },
          "initial_inputs": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "id",
          "source",
          "purpose",
          "input_schema",
          "initial_inputs"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 16,
      "description": "One canonical typed input per registered ID; all declared checks execute initially within shared budgets.",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "inputs": {
            "type": "object",
            "description": "Registry input schema and canonical 16 KiB cap validated locally."
          }
        },
        "required": [
          "check",
          "inputs"
        ],
        "additionalProperties": false
      }
    },
    "prior_results": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "submission_id"
        ],
        "properties": {
          "submission_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          }
        }
      },
      "description": "Immutable accepted submission IDs; every original declared claim is accepted atomically."
    }
  },
  "required": [
    "version",
    "title",
    "claims",
    "experiments"
  ],
  "additionalProperties": false
}
